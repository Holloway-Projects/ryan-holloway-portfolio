---
import { projects } from '../data/projects';
---
<section id="work">
  <div class="head"><h2 class="sec">The Work</h2></div>
  <div class="grid">
    {projects.map((p, i) => (
      <button class="work" data-index={i} data-video={p.preview ?? p.video} aria-label={`Open ${p.name}`}>
        <div class="fr">
          <img src={p.poster} alt="" loading={i < 3 ? 'eager' : 'lazy'} />
          <video muted loop playsinline preload="none"></video>
          <span class="rt">{p.runtime}</span>
        </div>
        <div class="cap"><div><b>{p.name}</b><span>{p.client}, {p.kind}</span></div><em>{p.year}</em></div>
      </button>
    ))}
  </div>
</section>
