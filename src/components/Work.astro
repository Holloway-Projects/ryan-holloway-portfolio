---
import { projects } from '../data/projects';
---
<section id="work">
  <div class="head"><h2 class="sec">The Work</h2></div>
  <div class="grid">
    {projects.map((p, i) => (
      <button class:list={['work', { placeholder: p.available === false }]} data-index={i} data-video={p.preview ?? p.video} disabled={p.available === false} aria-label={p.available === false ? `${p.name} coming soon` : `Open ${p.name}`}>
        <div class="fr">
          <img src={p.poster} alt="" loading={i < 3 ? 'eager' : 'lazy'} />
          <video muted loop playsinline preload="none"></video>
          {p.runtime && <span class="rt">{p.runtime}</span>}
        </div>
        <div class="cap"><div><b>{p.name}</b><span>{p.client}, {p.kind}</span></div><em>{p.year}</em></div>
      </button>
    ))}
  </div>
</section>
