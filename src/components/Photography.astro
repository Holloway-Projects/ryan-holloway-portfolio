---
import { photoRows } from '../data/photos';
---
<section id="photo" class="tint">
  <div class="head"><h2 class="sec">Photography</h2></div>
  <div class="photos">
    {photoRows.map((row) => (
      <div class="photo-row">
        {row.map((p) => (
          <button class:list={{ 'motorcycle-shot': p.src.includes('motorcycle') }} data-full={p.full} data-caption={p.caption} aria-label={`View ${p.caption}`}>
            <img src={p.src} alt={p.caption} width={p.width} height={p.height} loading="lazy" />
          </button>
        ))}
      </div>
    ))}
  </div>
</section>
