---
import { audio } from '../data/media';
import { site } from '../data/site';
---
<div class="craft" id="audio">
  <div class="chead"><h3>Sound Design</h3></div>
  <div class="audio-grid">
    <div class="ab">
      <div class="ab-top">
        <button class="btn" id="a-play" aria-label="Play or pause audio"><svg viewBox="0 0 12 12" id="a-ico"><path d="M2 1.5v9l8-4.5z"/></svg></button>
        <div class="tcr" id="a-tc">00:00:00:00 <span>/ 00:00:00:00</span></div>
        <div class="lab" id="a-lab">Interview · A001 · boom, placeholder audio</div>
      </div>
      <canvas id="wave" data-src={audio.dialogue}></canvas>
      <div class="xf">
        <span id="xf-raw">Raw</span>
        <input type="range" id="xfade" min="0" max="100" value="100" aria-label="Crossfade between raw and mixed audio" />
        <span id="xf-mix" class="on">Mix</span>
      </div>
      <div class="score">
        <span>Score</span>
        <div class="seg"><button class="on" id="sc-off">Dialogue only</button><button id="sc-on">With score bed</button></div>
        <label>Level<input type="range" id="sc-lvl" min="0" max="100" value="45" aria-label="Score level" /></label>
        <span class="duck" id="duck">ducking</span>
      </div>
      <p class="ab-note" id="a-status">Press play to load the placeholder audio.</p>
    </div>
    <div class="rack">
      <div class="rack-head"><b>Channel strip · Dialogue</b><span>placeholder for plugin capture</span></div>
      <canvas id="spec"></canvas>
      <div class="chain" id="chain">{site.soundChain.map(([n, v]) => <span>{n}<i>{v}</i></span>)}</div>
      <div class="meters"><div class="meter"><i id="m-l"></i></div><div class="meter"><i id="m-r"></i></div><span class="mono">L / R</span></div>
    </div>
  </div>
</div>
