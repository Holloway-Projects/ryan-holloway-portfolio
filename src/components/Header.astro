---
import { site } from '../data/site';
---
<header class="site" data-state="intro">
  <a class="brand" href="#reel" aria-label={site.name}>
    <img class="logo" src="/logo.png" alt="" width="920" height="759" />
  </a>
  <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">Menu</button>
  <nav id="site-nav">{site.nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
</header>
