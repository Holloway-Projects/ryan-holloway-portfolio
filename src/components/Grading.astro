---
import { grade } from '../data/grade';
const stages = grade.stages.filter((s) => s.src);
const [base, ...layers] = stages;
---
<div class="craft" id="grade">
  <div class="chead"><h3>Color Grading</h3></div>
  <div class="grader" id="grader" data-start={grade.start} style={`--x:${grade.start * 100}%;--g:100%`}>
    <div class="wipe" tabindex="0" role="slider" aria-label="Grading stages" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(grade.start * 100)}>
      <video class="base" muted loop playsinline autoplay preload="metadata" src={base.src}></video>
      {layers.map((s, i) => <video class="layer" data-k={i + 1} muted loop playsinline autoplay preload="metadata" src={s.src}></video>)}
      <div class="seam"></div>
      <div class="handle"></div>
    </div>
    <div class="legend">
      {stages.map((s, i) => <span class="band" data-k={i}>{s.name}</span>)}
      <span class="tick a"></span><span class="tick b"></span>
    </div>
  </div>
</div>
